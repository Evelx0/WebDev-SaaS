# --- Core ---
NODE_ENV=production
PORT=3000

# Public-facing base URL of the running app (no trailing slash)
APP_BASE_URL=http://localhost:3000

# --- Database & queue ---
# In docker-compose, hostnames resolve to service names.
# Keep POSTGRES_PASSWORD in sync with the password embedded in DATABASE_URL
# when using the bundled docker-compose Postgres service.
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://leadpanel:change_me@postgres:5432/leadpanel?schema=public
REDIS_URL=redis://redis:6379

# --- Auth ---
# Used to sign session JWT cookies. Use a long random string in production.
SESSION_SECRET=replace_me_with_a_long_random_string

# Initial admin account, seeded on first start if no users exist.
# After bootstrap you may delete or rotate these via the database.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_now

# --- AI providers ---
# At least one of these should be configured for live site generation.
# Without keys, the app falls back to a clearly-labelled local mock generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=xiaomi/mimo-v2-flash  # paid fallback — ~$0.09/$0.29 per 1M, SWE-bench #1 OSS
OPENROUTER_MODEL=openrouter/auto

# --- Lead enrichment providers ---
# Pick one. Google Places is preferred when available; otherwise SerpAPI.
GOOGLE_PLACES_API_KEY=
SERPAPI_API_KEY=

# --- Vercel deployment ---
# Personal or team token with deployment scope.
VERCEL_API_TOKEN=
# Optional team scope for deployments.
VERCEL_TEAM_ID=
# Slug prefix used when generating per-lead Vercel project names.
VERCEL_PROJECT_PREFIX=lead-demo

# --- Email (NOT used in MVP — placeholders only) ---
EMAIL_PROVIDER=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
FROM_EMAIL=

# --- Generated site storage ---
# Local filesystem path inside the container where generated sites are written.
GENERATED_SITES_DIR=/app/generated-sites
